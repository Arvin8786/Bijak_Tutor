/** Run manually from Apps Script editor. Additive import; never overwrites previously saved rows. */
function importCurriculumV6_(){
 initializeDatabase_();
 const existingLessons=new Set(rows_('Lessons').map(x=>String(x.lessonId)));
 const existingQs=new Set(rows_('Questions').map(x=>String(x.lessonId)+'/'+String(x.questionId)));
 const existingSkills=new Set(rows_('SkillMap').map(x=>String(x.skillId)));
 let lRows=[],qRows=[],sRows=[];
 EXPANDED_LESSONS_V6.forEach((l,i)=>{
  if(!existingLessons.has(l.id))lRows.push({lessonId:l.id,year:1,subject:'Matematik',title:l.title,summary:l.summary,icon:l.icon,mindJson:JSON.stringify(l.mind),stepsJson:JSON.stringify(l.steps),premium:'TRUE'});
  l.check.forEach(q=>{if(!existingQs.has(l.id+'/'+q.id))qRows.push({questionId:q.id,lessonId:l.id,mode:q.mode,text:q.text,optionsJson:JSON.stringify(q.options||[]),correctAnswer:q.answer,why:q.why,transfer:q.transfer?'TRUE':'FALSE',misconceptionsJson:'{}'});});
  const skillId='Y1-MATH-'+l.id.split('-').slice(-1)[0].toUpperCase();
  if(!existingSkills.has(skillId))sRows.push({skillId,lessonId:l.id,versionId:'KSSR-SEMAKAN-2017',year:1,subject:'Matematik',school:'SK',skillTitle:l.title,prerequisiteIdsJson:'[]',standardCodesJson:JSON.stringify(l.standards),contentStatus:'DRAFT_TEACHER_REVIEW',reviewedBy:'',reviewedAt:''});
 });
 const write=(name,items)=>{if(!items.length)return;const sheet=sheet_(name),keys=TABLES[name],start=sheet.getLastRow()+1;sheet.getRange(start,1,items.length,keys.length).setValues(items.map(o=>keys.map(k=>cell_(o[k]))));};
 const lock=LockService.getScriptLock();lock.waitLock(30000);
 try {write('Lessons',lRows);write('Questions',qRows);write('SkillMap',sRows);}finally{lock.releaseLock();}
 return {lessons:lRows.length,questions:qRows.length,skills:sRows.length,status:'DRAFT_TEACHER_REVIEW'};
}
