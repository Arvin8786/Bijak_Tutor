function seedSkillMap_(){
 const versionId='KSSR-SEMAKAN-2017', versionSheet=rows_('CurriculumVersions');
 if(!versionSheet.some(v=>v.versionId===versionId&&String(v.year)==='1'&&v.subject==='Matematik'&&v.school==='SK')){
  append_('CurriculumVersions',{versionId,year:1,subject:'Matematik',school:'SK',status:'CURRENT_REFERENCE',sourceUrl:'https://sites.google.com/moe-dl.edu.my/dskpskfp1/tahun-1',reviewNote:'Learning content is DEMO; teacher review required'});
 }
 const existingLessons=new Set(rows_('Lessons').map(l=>String(l.lessonId)));
 const existingQuestions=new Set(rows_('Questions').map(q=>String(q.lessonId)+'/'+String(q.questionId)));
 SEED_LESSONS.forEach(l=>{
  if(!existingLessons.has(l.id))append_('Lessons',{lessonId:l.id,year:l.year,subject:l.subject,title:l.title,summary:l.summary,icon:l.icon,mindJson:JSON.stringify(l.mind),stepsJson:JSON.stringify(l.steps),premium:'FALSE'});
  (l.check||[]).forEach(q=>{if(!existingQuestions.has(l.id+'/'+q.id))append_('Questions',{questionId:q.id,lessonId:l.id,mode:q.mode,text:q.text,optionsJson:JSON.stringify(q.options||[]),correctAnswer:q.answer,why:q.why,transfer:q.transfer?'TRUE':'FALSE',misconceptionsJson:JSON.stringify(l.misconceptions||{})});});
 });
 const lessonByTitle=Object.fromEntries(SEED_LESSONS.filter(l=>l.year===1&&l.subject==='Matematik').map(l=>[l.title,l.id]));
 const existing=new Set(rows_('SkillMap').map(x=>String(x.skillId)));
 SKILL_SEED.forEach(s=>{if(!existing.has(s.id))append_('SkillMap',{skillId:s.id,lessonId:lessonByTitle[s.title]||'',versionId,year:1,subject:'Matematik',school:'SK',skillTitle:s.title,prerequisiteIdsJson:JSON.stringify(s.prerequisites),standardCodesJson:JSON.stringify(s.standards),contentStatus:'DEMO_NOT_REVIEWED',reviewedBy:'',reviewedAt:''});});
}
