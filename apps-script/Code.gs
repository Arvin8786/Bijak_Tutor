/** BijakLearn Junior v3: Sheets is the only database, Apps Script is the only backend.
 * Deploy as web app: execute as ME (owner); access Anyone; every RPC verifies Google ID token.
 * In Script Properties set GOOGLE_CLIENT_ID and SPREADSHEET_ID. Never publish the sheet.
 */
const TABLES = {
 Subjects:['subjectId','subjectName','stream','stage','group','contentStatus','sourceUrl'],
 Parents:['googleSub','email','displayName','createdAt','parentPinHash','pinSalt'],
 Children:['childId','parentSub','nickname','year','school','language','createdAt'],
 Subscriptions:['googleSub','plan','status','expiresAt','updatedAt','adminNote'],
 ModuleCatalog:['moduleId','audience','title','tagline','icon','visibility','accessTier','contentStatus','reviewStatus','updatedAt'],
 ModuleLessons:['lessonId','moduleId','sequence','title','summary','stepsJson','questionJson','project','visibility','contentStatus','reviewStatus','updatedAt'],
 Payments:['paymentId','googleSub','reference','amountRM','status','verifiedAt','adminNote'],
 Lessons:['lessonId','year','subject','title','summary','icon','mindJson','stepsJson','premium','chapter','visual','school','contentStatus'],
 Questions:['questionId','lessonId','mode','text','optionsJson','correctAnswer','why','transfer','misconceptionsJson'],
 Attempts:['attemptId','childId','googleSub','lessonId','questionId','mode','correct','hints','transfer','answer','createdAt'],
 Mastery:['childId','lessonId','mastered','independent','formats','transfer','lastAttemptAt','reviewDue'],
 Scholarships:['requestId','googleSub','status','submittedAt','reviewedAt','adminNote'],
 CurriculumVersions:['versionId','year','subject','school','status','sourceUrl','reviewNote'],
 SkillMap:['skillId','lessonId','versionId','year','subject','school','skillTitle','prerequisiteIdsJson','standardCodesJson','contentStatus','reviewedBy','reviewedAt'],
 Audit:['timestamp','actor','action','reference']
};
function props_(){return PropertiesService.getScriptProperties()}
function sheet_(name){const ss=SpreadsheetApp.openById(props_().getProperty('SPREADSHEET_ID'));let s=ss.getSheetByName(name);if(!s)throw Error('Missing sheet '+name+'. Run initializeDatabase from the editor.');return s}
function rows_(name){const values=sheet_(name).getDataRange().getValues();const keys=TABLES[name];return values.slice(1).filter(r=>r.some(x=>x!=='')) .map(row=>Object.fromEntries(keys.map((k,i)=>[k,row[i] instanceof Date?row[i].toISOString():row[i]])))}
function cell_(v){if(v===undefined||v===null)return '';if(typeof v==='string'&&/^[\s]*[=+\-@]/.test(v))return '\''+v;return v;}
function append_(name,row){sheet_(name).appendRow(TABLES[name].map(k=>cell_(row[k])));}
function update_(name,key,value,patch){const s=sheet_(name),v=s.getDataRange().getValues(),keys=TABLES[name],ix=keys.indexOf(key);if(ix<0)throw Error('Invalid key');for(let i=1;i<v.length;i++){if(String(v[i][ix])===String(value)){Object.keys(patch).forEach(k=>{const col=keys.indexOf(k);if(col>=0)s.getRange(i+1,col+1).setValue(cell_(patch[k]));});return true}}return false}
function initializeDatabase_(){const ss=SpreadsheetApp.openById(props_().getProperty('SPREADSHEET_ID'));Object.entries(TABLES).forEach(([name,keys])=>{let s=ss.getSheetByName(name);if(!s)s=ss.insertSheet(name);if(s.getLastRow()===0){s.appendRow(keys);s.setFrozenRows(1)}else{
  // Additive schema migration: preserve all existing columns and learning data.
  const headers=s.getRange(1,1,1,s.getLastColumn()).getValues()[0].map(String);
  const missing=keys.slice(headers.length);
  if(keys.slice(0,headers.length).some((k,i)=>k!==headers[i]))throw Error('Unexpected schema for '+name+'; restore or migrate headers before importing');
  if(missing.length){if(s.getMaxColumns()<keys.length)s.insertColumnsAfter(s.getMaxColumns(),keys.length-s.getMaxColumns());s.getRange(1,headers.length+1,1,missing.length).setValues([missing]);}
 }});if(rows_('Lessons').length===0){SEED_LESSONS.forEach(l=>{append_('Lessons',{lessonId:l.id,year:l.year,subject:l.subject,title:l.title,summary:l.summary,icon:l.icon,mindJson:JSON.stringify(l.mind),stepsJson:JSON.stringify(l.steps),premium:l.id==='y1-math-subtract'?'FALSE':'TRUE'});(l.check||[]).forEach(q=>append_('Questions',{questionId:q.id,lessonId:l.id,mode:q.mode,text:q.text,optionsJson:JSON.stringify(q.options||[]),correctAnswer:q.answer,why:q.why,transfer:q.transfer?'TRUE':'FALSE',misconceptionsJson:JSON.stringify(l.misconceptions||{})}));});}seedSkillMap_();return 'Sheets initialized';}
function doGet(){const t=HtmlService.createTemplateFromFile('App');t.clientId=props_().getProperty('GOOGLE_CLIENT_ID')||'';return t.evaluate().setTitle('BijakLearn Junior').addMetaTag('viewport','width=device-width, initial-scale=1')}
function verify_(idToken){if(typeof idToken!=='string'||idToken.length>5000||idToken.length<50)throw Error('Sign in with your Google parent account');const clientId=props_().getProperty('GOOGLE_CLIENT_ID');if(!clientId)throw Error('Google Sign-In not configured');const response=UrlFetchApp.fetch('https://oauth2.googleapis.com/tokeninfo?id_token='+encodeURIComponent(idToken),{muteHttpExceptions:true});if(response.getResponseCode()!==200)throw Error('Google identity verification failed');const payload=JSON.parse(response.getContentText());if(payload.aud!==clientId||!['accounts.google.com','https://accounts.google.com'].includes(payload.iss)||String(payload.email_verified)!=='true'||Number(payload.exp)*1000<Date.now()||!payload.sub)throw Error('Invalid Google identity');return {sub:String(payload.sub),email:String(payload.email||''),name:String(payload.name||'Parent').slice(0,80)};}
function upsertParent_(u){if(!rows_('Parents').some(p=>p.googleSub===u.sub))append_('Parents',{googleSub:u.sub,email:u.email,displayName:u.name,createdAt:new Date().toISOString()});}
function withAuth_(token,fn){const user=verify_(token);upsertParent_(user);return fn(user)}
function requireChild_(u,childId){const child=rows_('Children').find(c=>c.childId===childId&&c.parentSub===u.sub);if(!child)throw Error('Child not linked to this parent');return child}
function access_(u){const entries=rows_('Subscriptions').filter(x=>x.googleSub===u.sub&&String(x.status).toUpperCase()==='ACTIVE'&&Date.parse(String(x.expiresAt))>Date.now()).sort((a,b)=>Date.parse(b.updatedAt||0)-Date.parse(a.updatedAt||0));const r=entries[0];return {active:!!r,plan:r?r.plan:'FREE',expiresAt:r?.expiresAt||null};}
function getBootstrap(token){return withAuth_(token,u=>({parent:{name:u.name,email:u.email},children:rows_('Children').filter(c=>c.parentSub===u.sub).map(c=>({id:c.childId,name:c.nickname,year:Number(c.year),school:c.school,language:c.language})),access:access_(u),lessons:rows_('Lessons').map(l=>({id:l.lessonId,title:l.title,year:Number(l.year),subject:l.subject,icon:l.icon,chapter:l.chapter||'',school:l.school||'ALL',status:l.contentStatus||'DRAFT_TEACHER_REVIEW',premium:String(l.premium).toUpperCase()==='TRUE'})),scholarship:rows_('Scholarships').filter(r=>r.googleSub===u.sub).slice(-1)[0]?.status||null}));}
function addChild(token,details){return withAuth_(token,u=>{const children=rows_('Children').filter(c=>c.parentSub===u.sub);if(children.length>=5)throw Error('Maximum five children per parent account');const name=String(details.name||'').trim().slice(0,40);const year=Number(details.year);if(!name||!Number.isInteger(year)||year<1||year>6)throw Error('Provide a child nickname and school year 1–6');const id=Utilities.getUuid();append_('Children',{childId:id,parentSub:u.sub,nickname:name,year,school:['SK','SJKC','SJKT'].includes(details.school)?details.school:'SK',language:['ms','en','ta','zh'].includes(details.language)?details.language:'ms',createdAt:new Date().toISOString()});return {id,name,year};});}
function getLesson(token,childId,lessonId){return withAuth_(token,u=>{requireChild_(u,childId);const l=rows_('Lessons').find(x=>x.lessonId===lessonId);if(!l)throw Error('Lesson not found');if(String(l.premium).toUpperCase()==='TRUE'&&!access_(u).active)throw Error('Premium or Premium Kasih membership required');const questions=rows_('Questions').filter(q=>q.lessonId===lessonId).map(q=>({id:q.questionId,mode:q.mode,text:q.text,options:JSON.parse(q.optionsJson||'[]'),transfer:String(q.transfer).toUpperCase()==='TRUE'}));return {id:l.lessonId,title:l.title,year:Number(l.year),subject:l.subject,icon:l.icon,summary:l.summary,visual:l.visual||'',chapter:l.chapter||'',school:l.school||'ALL',status:l.contentStatus||'DRAFT_TEACHER_REVIEW',mind:JSON.parse(l.mindJson||'[]'),steps:JSON.parse(l.stepsJson||'[]'),questions};});}
function computeMastery_(attempts){
  // Self-reported hints are not strong identity-proof, so this remains
  // formative evidence, NOT a verified high-stakes mastery certificate.
  const independent=attempts.filter(a=>a.correct===true&&Number(a.hints)===0&&['number','text','written'].includes(a.mode)&&a.questionId);
  const last=attempts.slice(-3);
  const recentIndependent=last.length===3&&last.every(a=>a.correct===true&&Number(a.hints)===0&&['number','text','written'].includes(a.mode));
  const variedQuestions=new Set(last.map(a=>a.questionId)).size===3;
  const unique=new Set(independent.map(a=>a.questionId));
  const transfer=independent.some(a=>a.transfer===true);
  return {mastered:recentIndependent&&variedQuestions&&unique.size>=3&&transfer,independent:unique.size,formats:new Set(independent.map(a=>a.mode)).size,transfer,verified:false};
}
function submitAttempt(token,childId,lessonId,questionId,answer,hints){return withAuth_(token,u=>{requireChild_(u,childId);const lesson=rows_('Lessons').find(l=>l.lessonId===lessonId);if(!lesson)throw Error('Lesson not found');if(String(lesson.premium).toUpperCase()==='TRUE'&&!access_(u).active)throw Error('Membership required');const q=rows_('Questions').find(x=>x.lessonId===lessonId&&x.questionId===questionId);if(!q)throw Error('Question not found');const provided=String(answer||'').trim().slice(0,150),usedHints=Math.max(0,Math.min(10,Math.floor(Number(hints)||0)));if(!provided)throw Error('Answer required');const correct=provided.toLocaleLowerCase()===String(q.correctAnswer).trim().toLocaleLowerCase();const now=new Date().toISOString(),attemptId=Utilities.getUuid();const lock=LockService.getScriptLock();lock.waitLock(10000);try{append_('Attempts',{attemptId,childId,googleSub:u.sub,lessonId,questionId,mode:q.mode,correct,transfer:String(q.transfer).toUpperCase()==='TRUE',hints:usedHints,answer:provided,createdAt:now});const a=rows_('Attempts').filter(r=>r.childId===childId&&r.lessonId===lessonId).slice(-60).map(x=>({correct:String(x.correct)==='true'||x.correct===true,hints:Number(x.hints),mode:x.mode,transfer:String(x.transfer)==='true'||x.transfer===true,questionId:x.questionId}));const result=computeMastery_(a);const old=rows_('Mastery').find(x=>x.childId===childId&&x.lessonId===lessonId);const row={childId,lessonId,mastered:result.mastered,independent:result.independent,formats:result.formats,transfer:result.transfer,lastAttemptAt:now,reviewDue:result.mastered?new Date(Date.now()+86400000).toISOString():''};
const ms=sheet_('Mastery'),vals=ms.getDataRange().getValues();let pos=-1;for(let i=1;i<vals.length;i++){if(String(vals[i][0])===childId&&String(vals[i][1])===lessonId){pos=i+1;break}}if(pos<0)append_('Mastery',row);else ms.getRange(pos,1,1,TABLES.Mastery.length).setValues([TABLES.Mastery.map(k=>cell_(row[k]))]);return {correct,feedback:correct?q.why:(JSON.parse(q.misconceptionsJson||'{}')[provided]||'Try a different visual approach and check what the question asks.'),mastery:result};}finally{lock.releaseLock()}});}
function getParentReport(token,childId,pin){return withAuth_(token,u=>{requireChild_(u,childId);const parent=rows_('Parents').find(p=>p.googleSub===u.sub);if(!parent?.parentPinHash)throw Error('Set a parent PIN first');const failedKey='pin_fail_'+u.sub;const cache=CacheService.getScriptCache();if(Number(cache.get(failedKey)||0)>=5)throw Error('Too many attempts. Try again later.');if(hashPin_(pin,parent.pinSalt)!==parent.parentPinHash){cache.put(failedKey,String(Number(cache.get(failedKey)||0)+1),900);throw Error('Incorrect parent PIN');}cache.remove(failedKey);const attempts=rows_('Attempts').filter(r=>r.childId===childId),mastery=rows_('Mastery').filter(r=>r.childId===childId);return {attempts:attempts.length,errors:attempts.filter(a=>String(a.correct)!=='true').length,independent:attempts.filter(a=>String(a.correct)==='true'&&Number(a.hints)===0&&['number','text','written'].includes(a.mode)).length,mastered:mastery.filter(m=>String(m.mastered)==='true').length,topics:mastery.map(x=>({lessonId:x.lessonId,mastered:String(x.mastered)==='true',independent:Number(x.independent),formats:Number(x.formats),lastAttemptAt:x.lastAttemptAt})),recent:attempts.slice(-20).map(a=>({lessonId:a.lessonId,mode:a.mode,correct:String(a.correct)==='true',hints:Number(a.hints),createdAt:a.createdAt}))};});}
function hashPin_(pin,salt){const val=String(pin||'');if(!/^\d{6}$/.test(val))throw Error('Use a six-digit parent PIN');const secret=props_().getProperty('PIN_PEPPER');if(!secret)throw Error('PIN_PEPPER script property is required');const bytes=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,salt+':'+val+':'+secret);return Utilities.base64Encode(bytes)}
function setParentPin(token,pin,oldPin){return withAuth_(token,u=>{const existing=rows_('Parents').find(p=>p.googleSub===u.sub);if(existing?.parentPinHash&&hashPin_(oldPin,existing.pinSalt)!==existing.parentPinHash)throw Error('Existing parent PIN required to change it');const salt=Utilities.getUuid(),hash=hashPin_(pin,salt);update_('Parents','googleSub',u.sub,{parentPinHash:hash,pinSalt:salt});return {ok:true};});}
function requestScholarship(token){return withAuth_(token,u=>{const existing=rows_('Scholarships').filter(x=>x.googleSub===u.sub).slice(-1)[0];if(existing&&['PENDING','APPROVED'].includes(existing.status))return {status:existing.status};const requestId=Utilities.getUuid();append_('Scholarships',{requestId,googleSub:u.sub,status:'PENDING',submittedAt:new Date().toISOString()});return {status:'PENDING'};});}

